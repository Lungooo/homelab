{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeMinor",
    ":semanticCommits"
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": [ "/^(gh|ls)cr\\.io\\/linuxserver\\//"],
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)((\\.|-r)(?<build>\\d+))?-ls(?<revision>\\d+)$"
    }
  ],
  "enabledManagers": [
    "docker-compose",
    "github-actions",
    "helm-values",
    "helmv3",
    "kustomize",
    "custom.regex"
  ],
  "customManagers": [
  {
    "customType": "regex",
    "managerFilePatterns": [
      "/.*y[a]?ml$/"
    ],
    "matchStrings": [
      "#\\s*renovate:\\s*datasource=(?<datasource>.*?)\\s+depName=(?<depName>.*?)(?:\\s+versioning=(?<versioning>.*?))?(?:\\s+registryUrl=(?<registryUrl>.*?))?\\s*\\n\\s*.*?version:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
    ],
    "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
  }
]
}
