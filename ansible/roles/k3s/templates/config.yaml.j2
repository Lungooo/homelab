---
{% if inventory_hostname == groups['k3s_server'][0] %}
cluster-init: true
{% else %}
server: https://{{ k3s_api_endpoint }}:6443
token: {{ k3s_node_token.content | b64decode | trim }}
{% endif %}
{% if k3s_is_server %}
tls-san:
  - {{ k3s_api_endpoint }}
disable:
{% for item in k3s_disable %}
  - {{ item }}
{% endfor %}
cluster-cidr: {{ k3s_cluster_cidr }}
service-cidr: {{ k3s_service_cidr }}
flannel-ipv6-masq: true
{% endif %}
node-ip: {{ k3s_node_ipv4 }},{{ ansible_host }}
